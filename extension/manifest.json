{
  "manifest_version": 3,
  "name": "Manga OCR & Mining for Anki",
  "short_name": "Manga Mining",
  "version": "0.2.0",
  "description": "Hover manga speech bubbles with Yomitan, click one for furigana, a grammar explanation and one-click Anki cards.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "scripting", "tabs", "offscreen"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://api.deepseek.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "optional_host_permissions": ["*://*/*", "<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel/panel.html" },
  "action": {
    "default_title": "anki_manga",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
